{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Python backend",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/apps/agent/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "adaptive_form_agent.api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--env-file",
        ".env",
        "--reload",
        "--reload-dir",
        "src",
        "--log-level",
        "debug"
      ],
      "cwd": "${workspaceFolder}/apps/agent",
      "envFile": "${workspaceFolder}/apps/agent/.env",
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": true
    }
  ]
}
